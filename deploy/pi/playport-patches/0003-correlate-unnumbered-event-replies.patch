+    @Test fun unnumberedRepliesConsumeEverySentCommandInOrder() {
+        val replies = AirPlayCommandReplies()
+        replies.sent(1) // Keyframe, without a waiter.
+        val app = replies.register(2)
+        replies.sent(2)
+        val unnumbered = response(0).copy(headers = emptyMap())
+        replies.handle(unnumbered)
+        assertFalse(app.isDone)
+        replies.handle(unnumbered)
+        assertTrue(app.join().accepted)
+    }
+
+    @Test fun lateUnnumberedReplyCannotCompleteANewerAppRequest() {
+        val replies = AirPlayCommandReplies()
+        val old = replies.register(1)
+        replies.sent(1)
+        replies.remove(1)
+        val current = replies.register(2)
+        replies.sent(2)
+        val unnumbered = response(0).copy(headers = emptyMap())
+        replies.handle(unnumbered)
+        assertFalse(old.isDone)
+        assertFalse(current.isDone)
+        replies.handle(unnumbered.copy(path = "404"))
+        assertFalse(current.join().accepted)
+    }
