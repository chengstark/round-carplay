+/**
+ * Keep a live RFCOMM bootstrap registered while the phone is pairing.
+ *
+ * Restarting a running bootstrap temporarily unregisters the BlueZ agent and
+ * SDP profile. A phone that starts pairing in that gap receives HCI
+ * "Pairing Not Allowed" and reports an unexplained pairing failure. A
+ * completed session may still request a fresh bootstrap, and an exited
+ * bootstrap is retried after the cooldown.
+ */
 internal fun shouldRetryWireless(
     bootstrapRunning: Boolean,
     elapsedMillis: Long,
     sessionEndedSinceBootstrap: Boolean,
 ): Boolean {
     if (elapsedMillis < 20_000L) return false
-    // Allow a fresh handshake time to complete, but bound a stuck initial setup.
-    return !bootstrapRunning || sessionEndedSinceBootstrap || elapsedMillis >= 90_000L
+    return !bootstrapRunning || sessionEndedSinceBootstrap
 }
