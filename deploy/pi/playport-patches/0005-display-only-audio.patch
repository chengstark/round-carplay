@@ -0,0 +1,45 @@
+package com.shilapi.xcertplay.airplay
+
+import com.shilapi.xcertplay.network.CarPlayBonjourProtocol
+import java.net.Socket
+import org.junit.Assert.*
+import org.junit.Test
+
+class DisplayOnlySessionTest {
+    private fun config() = AirPlayConfig(
+        deviceName = "test", deviceId = "02:00:00:00:00:02", btMac = "02:00:00:00:00:02",
+        sourceVersion = "366.0", main = AirPlayDisplayConfig(widthPixels = 512, heightPixels = 512),
+        disableAudioOutput = true,
+    )
+
+    @Test fun displayOnlyAdvertisementDoesNotClaimAudioFormatsOrAudioOwnership() {
+        val config = config()
+        val info = AirPlayInfoPlist.build(config)
+        assertFalse(info.containsKey("audioFormats"))
+        assertFalse(info.containsKey("audioLatencies"))
+        val resources = (info["modes"] as Map<*, *>)["resources"] as List<*>
+        assertEquals(listOf(1), resources.map { (it as Map<*, *>)["resourceID"] })
+        assertEquals("0x40000180,0x61", CarPlayBonjourProtocol.airPlayTxtRecords(config, AirPlayIdentity.generate())["features"])
+    }
+
+    @Test fun audioSetupCannotOpenAudioPortsWhileVideoSetupStillWorks() {
+        var audioCalls = 0
+        val session = AirPlaySession(
+            socket = Socket(), config = config(), identity = AirPlayIdentity.generate(),
+            pairings = PairingStore(), mfi = null, listener = object : AirPlaySessionListener {},
+            media = object : AirPlayMediaHandler {
+                override fun onAudio(session: AirPlaySession, type: Int, stream: Map<String, Any?>): Map<String, Any?>? {
+                    audioCalls++
+                    return mapOf("type" to type, "dataPort" to 9999)
+                }
+                override fun onScreen(session: AirPlaySession, type: Int, stream: Map<String, Any?>): Int = 8888
+            },
+        )
+        try {
+            val method = AirPlaySession::class.java.getDeclaredMethod("handleStreams", List::class.java).apply { isAccessible = true }
+            val response = method.invoke(session, listOf(100, 101, 102, 110).map { mapOf("type" to it) }) as List<*>
+            assertEquals(0, audioCalls)
+            assertEquals(listOf(110), response.map { (it as Map<*, *>)["type"] })
+        } finally { session.close() }
+    }
+}
