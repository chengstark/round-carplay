#!/usr/bin/env bash
set -euo pipefail

test "$(id -u)" -eq 0 || {
  echo "Camera Wi-Fi activation requires root" >&2
  exit 77
}

PROFILE=eeye-camera
INTERFACE=wlan0
SSID=backupcam_aee782870
PASSWORD_FILE=/etc/round-carplay/eeye-camera-wifi-password
PREVIOUS_WIFI_FILE=/run/round-carplay/previous-wifi-uuid

ACTIVE_PROFILE="$(nmcli -g GENERAL.CONNECTION device show "$INTERFACE" 2>/dev/null || true)"
ACTIVE_PROFILE="${ACTIVE_PROFILE%%$'\n'*}"
if test "$ACTIVE_PROFILE" = "$PROFILE"; then
  echo "Camera Wi-Fi is already connected"
  exit 0
fi

test -s "$PASSWORD_FILE" || {
  echo "Camera Wi-Fi password is not installed" >&2
  exit 78
}
IFS= read -r PASSWORD < "$PASSWORD_FILE"
test -n "$PASSWORD" || {
  echo "Camera Wi-Fi password is empty" >&2
  exit 78
}

if ! nmcli connection show "$PROFILE" >/dev/null 2>&1; then
  nmcli connection add \
    type wifi \
    ifname "$INTERFACE" \
    con-name "$PROFILE" \
    ssid "$SSID"
fi

nmcli connection modify "$PROFILE" \
  802-11-wireless.ssid "$SSID" \
  802-11-wireless.band bg \
  802-11-wireless.powersave 2 \
  802-11-wireless-security.key-mgmt wpa-psk \
  802-11-wireless-security.psk-flags 0 \
  802-11-wireless-security.psk "$PASSWORD" \
  connection.autoconnect no \
  connection.autoconnect-priority 0 \
  connection.autoconnect-retries 0 \
  ipv4.method auto \
  ipv6.method disabled

PREVIOUS_UUID="$(nmcli -t -f UUID,DEVICE connection show --active | awk -F: '$2 == "wlan0" { print $1; exit }')"
install -d -m 0755 "$(dirname "$PREVIOUS_WIFI_FILE")"
rm -f "$PREVIOUS_WIFI_FILE"
if [[ "$PREVIOUS_UUID" =~ ^[0-9A-Fa-f-]{36}$ ]]; then
  printf '%s\n' "$PREVIOUS_UUID" > "$PREVIOUS_WIFI_FILE"
  chmod 0600 "$PREVIOUS_WIFI_FILE"
fi

restore_after_failure() {
  status=$?
  trap - EXIT
  if test "$status" -ne 0; then
    echo "Camera Wi-Fi activation failed; restoring the previous network" >&2
    if [[ "$PREVIOUS_UUID" =~ ^[0-9A-Fa-f-]{36}$ ]] && \
       nmcli connection show uuid "$PREVIOUS_UUID" >/dev/null 2>&1; then
      nmcli --wait 30 connection up uuid "$PREVIOUS_UUID" ifname "$INTERFACE" >/dev/null 2>&1 || true
    else
      nmcli --wait 30 device connect "$INTERFACE" >/dev/null 2>&1 || true
    fi
    rm -f "$PREVIOUS_WIFI_FILE"
  fi
  exit "$status"
}
trap restore_after_failure EXIT

# The Pi's single Wi-Fi radio can return only the current AP's BSSIDs during a
# background scan. Releasing it first forces a full-channel foreground scan.
nmcli device disconnect "$INTERFACE" >/dev/null 2>&1 || true
SCAN_REQUESTED=0
for _attempt in {1..10}; do
  if nmcli device wifi rescan ifname "$INTERFACE" ssid "$SSID" >/dev/null 2>&1; then
    SCAN_REQUESTED=1
    break
  fi
  sleep 1
done
test "$SCAN_REQUESTED" -eq 1 || {
  echo "The Wi-Fi adapter did not become ready for a camera scan" >&2
  exit 1
}
sleep 2
nmcli --wait 30 connection up "$PROFILE" ifname "$INTERFACE"
trap - EXIT
unset PASSWORD
