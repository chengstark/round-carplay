#!/usr/bin/env bash
set -euo pipefail

test "$(id -u)" -eq 0 || {
  echo "Camera Wi-Fi activation requires root" >&2
  exit 77
}

PROFILE=xiao-camera
INTERFACE=wlan0
SSID=XIAO_ESP32S3_Sense
PASSWORD_FILE=/etc/round-carplay/camera-wifi-password
PREVIOUS_WIFI_FILE=/run/round-carplay/previous-wifi-uuid

ACTIVE_PROFILE="$(nmcli -g GENERAL.CONNECTION device show "$INTERFACE" 2>/dev/null || true)"
ACTIVE_PROFILE="${ACTIVE_PROFILE%%$'\n'*}"
if test "$ACTIVE_PROFILE" = "$PROFILE"; then
  echo "Camera Wi-Fi is already connected"
  exit 0
fi

PREVIOUS_UUID="$(nmcli -t -f UUID,DEVICE connection show --active | awk -F: '$2 == "wlan0" { print $1; exit }')"
if [[ "$PREVIOUS_UUID" =~ ^[0-9A-Fa-f-]{36}$ ]]; then
  install -d -m 0755 "$(dirname "$PREVIOUS_WIFI_FILE")"
  printf '%s\n' "$PREVIOUS_UUID" > "$PREVIOUS_WIFI_FILE"
  chmod 0600 "$PREVIOUS_WIFI_FILE"
fi

test -s "$PASSWORD_FILE" || {
  echo "Camera Wi-Fi password is not installed" >&2
  exit 78
}
IFS= read -r PASSWORD < "$PASSWORD_FILE"
test -n "$PASSWORD" || {
  echo "Camera Wi-Fi password is empty" >&2
  exit 78
}

if ! nmcli connection show "$PROFILE" >/dev/null 2>&1; then
  nmcli connection add \
    type wifi \
    ifname "$INTERFACE" \
    con-name "$PROFILE" \
    ssid "$SSID"
fi

nmcli connection modify "$PROFILE" \
  802-11-wireless.ssid "$SSID" \
  802-11-wireless.band bg \
  802-11-wireless.channel 6 \
  802-11-wireless.powersave 2 \
  802-11-wireless-security.key-mgmt wpa-psk \
  802-11-wireless-security.psk-flags 0 \
  802-11-wireless-security.psk "$PASSWORD" \
  connection.autoconnect no \
  connection.autoconnect-priority 0 \
  connection.autoconnect-retries 0 \
  ipv4.method auto \
  ipv6.method disabled

nmcli --wait 30 connection up "$PROFILE" ifname "$INTERFACE"
unset PASSWORD
