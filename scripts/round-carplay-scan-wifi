#!/usr/bin/env bash
set -euo pipefail

test "$(id -u)" -eq 0 || {
  echo "Full Wi-Fi scanning requires root" >&2
  exit 77
}

INTERFACE=wlan0

# Never disconnect the active profile for a menu scan. A scan that returns a
# partial list is recoverable; stranding the kiosk off-network is not.
SCAN_REQUESTED=0
for _attempt in {1..10}; do
  if nmcli device wifi rescan ifname "$INTERFACE" >/dev/null 2>&1; then
    SCAN_REQUESTED=1
    break
  fi
  sleep 1
done
test "$SCAN_REQUESTED" -eq 1 || {
  echo "The Wi-Fi adapter did not become ready for scanning" >&2
  exit 1
}

SCAN_OUTPUT=
for _attempt in {1..10}; do
  sleep 1
  SCAN_OUTPUT="$(nmcli \
    --terse \
    --escape yes \
    --fields IN-USE,SSID,SIGNAL,SECURITY \
    device wifi list \
    ifname "$INTERFACE" \
    --rescan no)"
  if test -n "$SCAN_OUTPUT"; then
    break
  fi
done
test -n "$SCAN_OUTPUT" || {
  echo "The Wi-Fi scan completed without returning any networks" >&2
  exit 1
}

printf '%s\n' "$SCAN_OUTPUT"
